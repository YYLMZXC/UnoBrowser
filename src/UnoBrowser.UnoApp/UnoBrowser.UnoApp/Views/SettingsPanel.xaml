<UserControl
    x:Class="UnoBrowser.UnoApp.Views.SettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:UnoBrowser.UnoApp.ViewModels"
    xmlns:views="using:UnoBrowser.UnoApp.Views"
    mc:Ignorable="d"
    d:DesignWidth="400" d:DesignHeight="600">

    <UserControl.Resources>
        <!-- 标签选中/未选中颜色 -->
        <SolidColorBrush x:Key="TabSelectedBg" Color="#0078D4" />
        <SolidColorBrush x:Key="TabUnselectedBg" Color="Transparent" />
        <SolidColorBrush x:Key="TabSelectedFg" Color="White" />
        <SolidColorBrush x:Key="TabUnselectedFg" Color="#666666" />

        <!-- 白色面板下的固定文字颜色 -->
        <SolidColorBrush x:Key="PanelTextColor" Color="#1A1A1A" />
    </UserControl.Resources>

    <!-- 右侧滑出面板（固定白色，像浏览器设置弹层） -->
    <Border Background="White"
            BorderBrush="#E0E0E0"
            BorderThickness="1,0,0,0"
            CornerRadius="8,0,0,8"
            Padding="16,12"
            MinWidth="300"
            MaxWidth="420">

        <Grid RowDefinitions="Auto,Auto,*">
            <!-- Header: 标题 + 关闭按钮 -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="设置" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource PanelTextColor}"
                           VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="✕" Width="32" Height="32"
                        FontSize="14" Padding="4"
                        Foreground="{StaticResource PanelTextColor}"
                        Click="CloseButton_Click" />
            </Grid>

            <!-- Tab 切换按钮 -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,0,0,12">
                <Button x:Name="BrowserSettingsTab"
                        Content="浏览器标识" FontSize="13" Padding="12,6"
                        Click="BrowserSettingsTab_Click"
                        Background="{StaticResource TabSelectedBg}"
                        Foreground="{StaticResource TabSelectedFg}" />
                <Button x:Name="DownloadTab"
                        Content="下载管理" FontSize="13" Padding="12,6"
                        Click="DownloadTab_Click"
                        Background="Transparent"
                        Foreground="{StaticResource TabUnselectedFg}" />
                <Button x:Name="HistoryTab"
                        Content="历史记录" FontSize="13" Padding="12,6"
                        Click="HistoryTab_Click"
                        Background="Transparent"
                        Foreground="{StaticResource TabUnselectedFg}" />
                <Button x:Name="AboutTab"
                        Content="关于" FontSize="13" Padding="12,6"
                        Click="AboutTab_Click"
                        Background="Transparent"
                        Foreground="{StaticResource TabUnselectedFg}" />
            </StackPanel>

            <!-- 内容区域 -->
            <Grid Grid.Row="2">
                <!-- Tab 0: 浏览器标识设置 -->
                <StackPanel x:Name="BrowserSettingsPanel" Spacing="12" Visibility="Visible">
                    <TextBlock Text="浏览器标识 (User-Agent)" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource PanelTextColor}" />
                    <TextBlock Text="选择浏览网页时使用的浏览器标识。修改后当前页面将自动刷新。"
                               FontSize="12" Foreground="Gray" TextWrapping="Wrap" />
                    <ComboBox x:Name="UaComboBox"
                              ItemsSource="{Binding UaOptions}"
                              SelectedIndex="{Binding SelectedUaIndex, Mode=TwoWay}"
                              FontSize="13"
                              HorizontalAlignment="Stretch"
                              MaxDropDownHeight="200">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:UaOption">
                                <TextBlock Text="{Binding DisplayName}" FontSize="13"
                                           VerticalAlignment="Center" Margin="0,4" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <!-- Tab 1: 下载管理 -->
                <StackPanel x:Name="DownloadSettingsPanel" Spacing="8" Visibility="Collapsed">
                    <views:DownloadListPanel x:Name="DownloadListControl"
                                             DataContext="{Binding DownloadList}" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <Button Content="打开下载文件夹" FontSize="12"
                                Command="{Binding OpenDownloadFolderCommand}" />
                        <Button Content="清除下载记录" FontSize="12"
                                Command="{Binding ClearDownloadHistoryCommand}" />
                    </StackPanel>
                </StackPanel>

                <!-- Tab 3: 关于 -->
                <StackPanel x:Name="AboutPanel" Spacing="12" Visibility="Collapsed">
                    <TextBlock Text="关于 Uno浏览器" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource PanelTextColor}" />

                    <Border BorderBrush="#E0E0E0" BorderThickness="1"
                            CornerRadius="6" Padding="16" Background="#FAFAFA">
                        <StackPanel Spacing="12">
                            <!-- 应用名称 + 版本 -->
                            <StackPanel HorizontalAlignment="Center" Spacing="4">
                                <TextBlock Text="🌐" FontSize="36" HorizontalAlignment="Center" />
                                <TextBlock Text="Uno浏览器" FontSize="18" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Foreground="{StaticResource PanelTextColor}" />
                                <TextBlock x:Name="VersionText" FontSize="12" Foreground="Gray"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <Border Background="#E8E8E8" Height="1" Margin="0,4" />

                            <!-- 描述 -->
                            <TextBlock Text="基于 Uno Platform 构建的跨平台浏览器，支持 Windows、Android、iOS、macOS。"
                                       FontSize="13" TextWrapping="Wrap"
                                       Foreground="{StaticResource PanelTextColor}" />
n                            <Border Background="#E8E8E8" Height="1" Margin="0,4" />
n                            <!-- 技术栈 -->
                            <TextBlock Text="技术栈" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource PanelTextColor}" />
                            <TextBlock FontSize="12" Foreground="#555555" TextWrapping="Wrap">
                                <Run Text="• " /><Run Text="Uno Platform" FontWeight="SemiBold" /><Run Text=" — 跨平台 UI 框架" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#555555" TextWrapping="Wrap">
                                <Run Text="• " /><Run Text="WebView2" FontWeight="SemiBold" /><Run Text=" — 桌面端浏览器内核" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#555555" TextWrapping="Wrap">
                                <Run Text="• " /><Run Text="CommunityToolkit.Mvvm" FontWeight="SemiBold" /><Run Text=" — MVVM 框架" />
                            </TextBlock>
                            <TextBlock FontSize="12" Foreground="#555555" TextWrapping="Wrap">
                                <Run Text="• " /><Run Text="Newtonsoft.Json" FontWeight="SemiBold" /><Run Text=" — JSON 序列化" />
                            </TextBlock>

                            <Border Background="#E8E8E8" Height="1" Margin="0,4" />
n                            <!-- 开源许可 -->
                            <TextBlock Text="© 2024 UnoBrowser. All rights reserved."
                                       FontSize="11" Foreground="#999999"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Tab 2: 历史记录 -->
                <StackPanel x:Name="HistorySettingsPanel" Spacing="8" Visibility="Collapsed">
                    <TextBlock Text="浏览历史" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource PanelTextColor}" />
                    <TextBlock Text="点击条目可跳转到对应页面。" FontSize="12"
                               Foreground="Gray" TextWrapping="Wrap" />

                    <Border BorderBrush="#E0E0E0" BorderThickness="1"
                            CornerRadius="6" Padding="8" Background="#FAFAFA">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 工具栏：多选切换 + 删除选中 -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="0,0,0,6">
                                <Button Content="{Binding MultiSelectButtonText}" FontSize="11" Padding="8,4"
                                        Command="{Binding ToggleMultiSelectCommand}" />
                                <Button Content="删除选中" FontSize="11" Padding="8,4"
                                        Command="{Binding DeleteSelectedHistoryCommand}"
                                        CommandParameter="{Binding History}"
                                        Visibility="{Binding IsHistoryMultiSelectMode, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </StackPanel>

                            <!-- 历史记录列表 -->
                            <ListView x:Name="HistoryListBox"
                                      Grid.Row="1"
                                      MaxHeight="400"
                                      Background="Transparent"
                                      BorderThickness="0"
                                      SelectionMode="Multiple"
                                      SelectionChanged="HistoryListBox_SelectionChanged">
                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="vm:BrowsingHistoryRecord">
                                        <Grid Padding="8,4" ColumnSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- 左侧：标题 + URL + 时间 -->
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Title}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{StaticResource PanelTextColor}" />
                                                <TextBlock Text="{Binding Url}"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="Gray"
                                                           Margin="0,2,0,0" />
                                                <TextBlock Text="{Binding TimeDisplay}"
                                                           FontSize="10" Foreground="#999999"
                                                           Margin="0,2,0,0" />
                                            </StackPanel>

                                            <!-- 右侧：单条删除按钮 -->
                                            <Button Grid.Column="1"
                                                    Content="✕" Width="24" Height="24"
                                                    FontSize="11" Padding="0"
                                                    VerticalAlignment="Center"
                                                    Background="Transparent"
                                                    Foreground="#999999"
                                                    Click="DeleteSingleHistory_Click"
                                                    Tag="{Binding Url}"
                                                    ToolTipService.ToolTip="删除此记录" />
                                        </Grid>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>

                            <!-- 底部：清除全部 -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button Content="清除全部历史" FontSize="12"
                                        Command="{Binding ClearHistoryCommand}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
