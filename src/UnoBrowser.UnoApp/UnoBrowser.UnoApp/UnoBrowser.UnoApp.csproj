<Project Sdk="Uno.Sdk" TreatAsLocalProperty="RuntimeIdentifiers">
    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-desktop</TargetFrameworks>

        <!--
          修复：IDE 对整个多目标项目还原时可能传入 RuntimeIdentifiers=win-x64（全局属性），
          而 android/ios 目标强制使用 Mono 运行时，会去请求不存在的
          Microsoft.NETCore.App.Runtime.Mono.win-x64 包（dotnet/maui#27215）。
          这里把非桌面目标的 RID 固定为平台自身的 RID，
          桌面目标保持 win-x64（CoreCLR 运行时包存在）。
          注意：TreatAsLocalProperty 只能忽略 RuntimeIdentifiers（复数），
          不能忽略 RuntimeIdentifier（单数），否则 Android 多 RID 的
          inner build 拿不到 RID 元数据，报 XAPRAS7009。
        -->
        <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64;android-x64</RuntimeIdentifiers>
        <RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">ios-arm64</RuntimeIdentifiers>
        <OutputType>Exe</OutputType>
        <UnoSingleProject>true</UnoSingleProject>
        <Nullable>enable</Nullable>

        <!-- Display name -->
        <ApplicationTitle>Uno浏览器</ApplicationTitle>
        <!-- App Identifier -->
        <ApplicationId>com.companyname.unobrowser.yylmzxc001</ApplicationId>
        <!-- Versions -->
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <ApplicationPublisher>Uno浏览器</ApplicationPublisher>
        <Description>Uno浏览器 powered by Uno Platform.</Description>

        <!--
          UnoFeatures are used to quickly add and manage features enabled for your app.
          https://aka.platform.uno/singleproject-features
        -->
        <UnoFeatures>SkiaRenderer;Toolkit;ThemeService;Dsp</UnoFeatures>

        <!-- Android ABI: arm64 for physical devices, x64 for emulators (Android-only) -->
        <AndroidCreatePackagePerAbi Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</AndroidCreatePackagePerAbi>

        <!-- Android 签名配置 -->
        <AndroidKeyStore>true</AndroidKeyStore>
        <AndroidSigningKeyStore>key\scassistant.keystore</AndroidSigningKeyStore>
        <AndroidSigningStorePass>sc123456</AndroidSigningStorePass>
        <AndroidSigningKeyAlias>scassistant</AndroidSigningKeyAlias>
        <AndroidSigningKeyPass>sc123456</AndroidSigningKeyPass>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
        <!-- 覆盖 Uno.WinUI 传递依赖的旧版 Microsoft.Windows.CsWin32 (0.3.106)，该版本存在已知安全漏洞 -->
        <PackageReference Include="Microsoft.Windows.CsWin32" Version="0.3.321" PrivateAssets="all" />
    </ItemGroup>

    <!-- WebView2 桌面后端：仅桌面平台需要，用别名避免与 Uno.UI 的 CoreWebView2 类型冲突 -->
    <ItemGroup Condition="$(TargetFramework.Contains('desktop'))">
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" Aliases="WpfWebView" />
    </ItemGroup>

    <!-- 桌面平台：嵌入图标到可执行文件（Win32 资源） -->
    <PropertyGroup Condition="$(TargetFramework.Contains('desktop'))">
        <ApplicationIcon>Assets\Icon.ico</ApplicationIcon>
    </PropertyGroup>
</Project>
